  </property>
  <property name="windowTitle">
   <string>📅 日程管家</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
        <string>
                /* 主背景色 */
        QWidget#centralwidget {
            background-color: #1e1e1e;
        }
        
        /* ==================== 全局表格控制 ==================== */
        QTableWidget {
            background-color: #252526;
            color: #e0e0e0;
            gridline-color: #3e3e42;
            border: none;
        }
        QTableWidget::item {
            background-color: #252526;
        }
        QTableWidget::item:alternate {
            background-color: #2d2d2f;
        }
        QTableWidget::item:selected {
            background-color: #4a4a4d;
            color: #ffffff;
        }
        QHeaderView {
            background-color: #1e1e1e;
        }
        QHeaderView::section {
            background-color: #333333;
            color: #ffffff;
            border: none;
            padding: 6px;
            border-bottom: 1px solid #444444;
        }

        /* ==================== 全局日历控制 ==================== */
        QCalendarWidget {
            background-color: #252526;
            border: none; /* 去除外围白边 */
        }
        QCalendarWidget QWidget {
            color: #e0e0e0; 
            background-color: #252526;
        }
        
        /* ★★★ 核心修复：把星期头(日一二)和周数列(27,28)由白色改成灰色 ★★★ */
        QCalendarWidget QTableView {
            background-color: #252526; 
            border: none; /* 去掉右下角的白块和细边框 */
        }
        QCalendarWidget QTableView QHeaderView {
            background-color: #252526;  /* 表头背景变深灰 */
        }
        QCalendarWidget QTableView QHeaderView::section {
            background-color: #2d2d2f;  /* 表头单元格变成浅灰，和表格融为一体 */
            color: #e0e0e0;             /* 文字变亮白 */
            border: none;
        }

        /* 日历主体日期部分 */
        QCalendarWidget QAbstractItemView:enabled {
            color: #e0e0e0;
            background-color: #252526;
            selection-background-color: #4a4a4d;
            selection-color: #ffffff;
        }

        /* 日历顶部导航按钮 */
        QCalendarWidget QToolButton {
            color: white;
            background-color: #333333;
            border: none;
            icon-size: 14px;
        }
        /* 解决日历左上角年月下拉框的白色背景 */
        QCalendarWidget QToolButton::menu {
            background-color: #333333;
            color: #ffffff;
        }
        QCalendarWidget QComboBox {
            background-color: #333333;
            color: #ffffff;
            border: 1px solid #444444;
        }
        QCalendarWidget QComboBox::drop-down {
            background-color: #333333;
        }
        QCalendarWidget QComboBox QAbstractItemView {
            background-color: #333333;
            color: #ffffff;
            selection-background-color: #4a4a4d;
        }

        /* ==================== 右侧面板 ==================== */
        QGroupBox {
            color: #e0e0e0;
            font-weight: bold;
            border: 1px solid #3e3e42;
            margin-top: 10px;
        }
        QGroupBox::title {
            color: #e0e0e0;
            subcontrol-origin: margin;
            left: 10px;
        }
        QPushButton {
            background-color: #333333;
            color: #e0e0e0;
            border: none;
            padding: 10px 16px;
            text-align: left;
        }
        QPushButton:hover {
            background-color: #404040;
        }
        QPushButton:pressed {
            background-color: #555555;
        }
        QPushButton:focus {
            outline: none;
            background-color: #333333; 
        }
        QLabel {
            color: #e0e0e0;
        }
    </string>
    </property>
